{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": ".",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "modules/**/*",
    "wallpaper.js",
    "live2d_controller.js",
    "types/amadeus.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "lib"
  ]
}
